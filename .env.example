# Copy this file to .env and fill in real values. Never commit .env.

# Required: TiDB / MySQL connection string
DATABASE_URL=mysql://USER:PASSWORD@HOST:4000/DATABASE_NAME

# Required: signs access tokens and email codes. At least 32 random characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Email: Gmail SMTP. SMTP_PASS is a Google "App password" (needs 2-Step Verification),
# not your normal Gmail password.
SMTP_USER=you@gmail.com
SMTP_PASS=
MAIL_FROM="Planner Flow <you@gmail.com>"

# Development only: "file" writes emails to .mail-outbox/ instead of sending them,
# "smtp" sends real email. Production always uses smtp.
MAIL_MODE=file

# Optional: apply database/schema.sql on server start (default: development only)
AUTO_MIGRATE=

# Required: encrypts life-lesson titles and text in the database (AES-256-GCM).
# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it safe and never change it once data exists: text encrypted with an old key can't be read.
ENCRYPTION_KEY=

# Optional: push notifications through Firebase Cloud Messaging.
# Firebase console → Project settings → Service accounts → Generate new private key,
# then base64-encode the downloaded JSON file (one line) and paste it here.
# PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("C:\path\to\key.json"))
# Without it, announcements still reach the in-app inbox.
FIREBASE_SERVICE_ACCOUNT=

# Required on Vercel: protects the daily cleanup job (/api/cron/cleanup).
# Any long random string; Vercel Cron sends it automatically.
CRON_SECRET=

# Public address of this backend, used for links the server hands out (data
# export). Set it in production so forged Host headers cannot change them.
APP_URL=https://planner-flow-backend.vercel.app
